root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,xml}]
indent_size = 2

[android-client/app/src/main/res/**/*.xml]
indent_size = 4

[*.{sh,command}]
indent_size = 4
end_of_line = lf

[*.bat]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
