<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aurora_surface">

    <!-- 120Hz Hardware Accelerated Video Surface -->
    <SurfaceView
        android:id="@+id/videoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Aurora Dashboard Container (Visible when not streaming) -->
    <FrameLayout
        android:id="@+id/dashboardLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Ambient Aurora Backdrop with soft colored blobs -->
        <com.displaymac.client.ui.AuroraBackgroundView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Main Dashboard Content ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:gravity="center_horizontal">

                <!-- 1. Top Header Bar (Responsive Layout) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp">

                    <!-- Left: Brand Logo & Title -->
                    <LinearLayout
                        android:id="@+id/layoutBrandHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="22dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/content_desc_brand_logo"
                            android:scaleType="fitCenter"
                            android:src="@drawable/brand_logo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/app_name"
                            android:textColor="@color/aurora_ink"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Right: Tablet Specs Pill -->
                    <LinearLayout
                        android:id="@+id/panelSpecsPill"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/layoutBrandHeader"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/pill_top_specs"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_device_tablet" />

                        <TextView
                            android:id="@+id/panelSpecsBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/hero_subtitle_default"
                            android:textColor="@color/aurora_ink_tertiary"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Center Content Column (Compact / Portrait) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <!-- 2. Hero Section -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:id="@+id/radarIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/ring_hero">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_device_desktop" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/dashStatusTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/hero_title_default"
                            android:textColor="@color/aurora_ink"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/dashStatusSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/hero_subtitle_default"
                            android:textColor="@color/aurora_ink_secondary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <!-- 3. Connection Cards (Stacked Vertically for Compact / Mobile / Narrow Screens) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Card 1: USB-C Cable (Recommended) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/card_aurora_bg"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_recommended"
                                android:paddingStart="10dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:text="@string/badge_recommended"
                                android:textColor="@color/aurora_blue_dark"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-medium" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_usb" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/usb_card_title"
                                    android:textColor="@color/aurora_ink"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="3dp"
                                    android:text="@string/chip_usb_wired"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="3dp"
                                    android:text="@string/chip_low_latency"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="3dp"
                                    android:text="@string/chip_usb_bitrate"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/chipUsbFps"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="3dp"
                                    android:text="@string/chip_fps_format"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutUsbStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:layout_marginTop="14dp"
                                android:layout_marginBottom="12dp"
                                android:background="@drawable/status_pill_bg"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="7dp"
                                android:paddingBottom="7dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ProgressBar
                                    android:id="@+id/searchProgress"
                                    style="?android:attr/progressBarStyleSmall"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:indeterminate="true"
                                    android:indeterminateTint="@color/aurora_blue"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/ivUsbStatusIcon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_usb"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/tvStatusMessage"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/usb_status_ready"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="12sp"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                            </LinearLayout>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnConnectUsb"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/btn_aurora_primary"
                                android:text="@string/btn_connect_usb"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textAllCaps="false"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <!-- Card 2: Wi-Fi (Wireless) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/card_aurora_bg"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_wireless"
                                android:paddingStart="10dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:text="@string/badge_wireless"
                                android:textColor="@color/aurora_sky_dark"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-medium" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_wifi" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/wifi_card_title"
                                    android:textColor="@color/aurora_ink"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="3dp"
                                    android:text="@string/chip_wifi_standard"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="3dp"
                                    android:text="@string/chip_wifi_bitrate"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/chipWifiFps"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="3dp"
                                    android:text="@string/chip_fps_format"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutWifiDiscovery"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:layout_marginBottom="12dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:id="@+id/layoutFoundMac"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="48dp"
                                    android:background="@drawable/status_pill_bg"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:paddingTop="7dp"
                                    android:paddingBottom="7dp"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_device_desktop" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvDiscoveredMacTitle"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="@string/mac_discovered_default_title"
                                            android:textColor="@color/aurora_ink"
                                            android:textSize="12sp"
                                            android:fontFamily="sans-serif-medium"
                                            android:includeFontPadding="false" />

                                        <TextView
                                            android:id="@+id/tvWifiDiscoveryStatus"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/wifi_status_searching_bonjour"
                                            android:textColor="@color/aurora_ink_secondary"
                                            android:textSize="11sp"
                                            android:includeFontPadding="false" />
                                    </LinearLayout>

                                    <ImageView
                                        android:id="@+id/ivWifiFoundCheck"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_check_circle"
                                        android:visibility="gone" />
                                </LinearLayout>

                                <EditText
                                    android:id="@+id/manualIpInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:layout_marginTop="8dp"
                                    android:background="@drawable/edittext_aurora"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:hint="@string/hint_mac_ip"
                                    android:textColor="@color/aurora_ink"
                                    android:textColorHint="@color/aurora_ink_secondary"
                                    android:textSize="13sp"
                                    android:inputType="textUri"
                                    android:imeOptions="actionDone"
                                    android:importantForAutofill="no"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/btnToggleManualIp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/btn_enter_ip_manually"
                                    android:textColor="@color/aurora_blue"
                                    android:textSize="12sp"
                                    android:padding="4dp" />
                            </LinearLayout>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnConnectWifi"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/btn_aurora_tonal"
                                android:text="@string/btn_connect_wifi"
                                android:textColor="@color/aurora_blue_dark"
                                android:textSize="14sp"
                                android:textAllCaps="false"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 4. Bottom Feature Strip (2x2 Grid for Responsive Compact Screens) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/card_aurora_bg"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Row 1: Stylus ready + Native refresh rate -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="4dp">

                                <FrameLayout
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/feature_circle_bg">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_pencil" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvFeatureStylusTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/feature_stylus_title"
                                        android:textColor="@color/aurora_ink"
                                        android:textSize="12sp"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/feature_stylus_sub"
                                        android:textColor="@color/aurora_ink_secondary"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="4dp">

                                <FrameLayout
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/feature_circle_bg">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_gauge" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvFeatureRefreshTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/feature_refresh_format"
                                        android:textColor="@color/aurora_ink"
                                        android:textSize="12sp"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/feature_refresh_sub"
                                        android:textColor="@color/aurora_ink_secondary"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Row 2: HEVC decoding + Main or extra -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="4dp">

                                <FrameLayout
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/feature_circle_bg">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_bolt" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/feature_hevc_title"
                                        android:textColor="@color/aurora_ink"
                                        android:textSize="12sp"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/feature_hevc_sub"
                                        android:textColor="@color/aurora_ink_secondary"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="4dp">

                                <FrameLayout
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/feature_circle_bg">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_devices" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/feature_display_title"
                                        android:textColor="@color/aurora_ink"
                                        android:textSize="12sp"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/feature_display_sub"
                                        android:textColor="@color/aurora_ink_secondary"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Floating HUD Overlay (Visible only when streaming) -->
    <LinearLayout
        android:id="@+id/hudOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/hud_background"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hud_connected_format"
            android:textColor="@color/aurora_success"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/fpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/chip_fps_format"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:id="@+id/speedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/chip_usb_bitrate"
            android:textColor="@color/aurora_sky"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDisconnect"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/btn_disconnect_bg"
            android:text="@string/hud_disconnect"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textAllCaps="false" />
    </LinearLayout>

</FrameLayout>
