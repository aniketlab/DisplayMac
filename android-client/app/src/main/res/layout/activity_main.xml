<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A0F">

    <!-- 120Hz Hardware Accelerated Video Surface -->
    <SurfaceView
        android:id="@+id/videoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Professional Dashboard UI (Visible while waiting for Mac connection) -->
    <LinearLayout
        android:id="@+id/dashboardLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#070A0F"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="DisplayMac"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_pill"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="PRO 120Hz"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/panelSpecsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/badge_pill"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="14.6&quot; Dynamic AMOLED 2X • 2960×1848"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </RelativeLayout>

        <!-- Center Scanning Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/radarIcon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_mac_mini" />

            <ProgressBar
                android:id="@+id/searchProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="20dp"
                android:indeterminateTint="#38BDF8" />

            <TextView
                android:id="@+id/dashStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Waiting for Mac mini M4..."
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/dashStatusSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Plug in USB-C cable for 0ms lag, or connect both devices to the same Wi-Fi."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- Specs & Cards Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="32dp">

                <!-- Card 1: Display -->
                <LinearLayout
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_glass_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET DISPLAY"
                        android:textColor="#475569"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="2960 × 1848"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="120 FPS ProMotion"
                        android:textColor="#34D399"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card 2: Link -->
                <LinearLayout
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_glass_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONNECTION LINK"
                        android:textColor="#475569"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/cardLinkStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="USB / Wi-Fi"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/cardLinkSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Auto-Detecting..."
                        android:textColor="#38BDF8"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card 3: Decoder -->
                <LinearLayout
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_glass_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HARDWARE ACCEL"
                        android:textColor="#475569"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="LowLatency HEVC"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Dimensity 9300+ MediaCodec"
                        android:textColor="#A78BFA"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Manual IP Connect Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="32dp">

                <EditText
                    android:id="@+id/manualIpInput"
                    android:layout_width="220dp"
                    android:layout_height="44dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Mac IP (e.g. 192.168.1.5)"
                    android:textColorHint="#475569"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="textUri"
                    android:singleLine="true" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/connectBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_primary"
                    android:text="Connect"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make sure 'DisplayMacServer' is running on your Mac Mini M4"
            android:textColor="#475569"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Floating HUD during Live Stream (Subtle Glassmorphic Pill) -->
    <LinearLayout
        android:id="@+id/hudOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/hud_background"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <View
            android:id="@+id/statusIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/circle_green" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Connected (USB 5 Gbps)"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/fpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="120 FPS"
            android:textColor="@color/status_green"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold" />
    </LinearLayout>

</FrameLayout>
