<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aurora_surface">

    <!-- 120Hz Hardware Accelerated Video Surface -->
    <SurfaceView
        android:id="@+id/videoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Aurora Dashboard Container (Visible when not streaming) -->
    <FrameLayout
        android:id="@+id/dashboardLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Ambient Aurora Backdrop with soft colored blobs -->
        <com.displaymac.client.ui.AuroraBackgroundView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Main Dashboard Content ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:gravity="center_horizontal">

                <!-- 1. Top Header Bar (Responsive Layout) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp">

                    <!-- Left: Brand Logo & Title -->
                    <LinearLayout
                        android:id="@+id/layoutBrandHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_logomark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="DisplayMac"
                            android:textColor="@color/aurora_ink"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Right: Tablet Specs Pill -->
                    <LinearLayout
                        android:id="@+id/panelSpecsPill"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/layoutBrandHeader"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/pill_top_specs"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_device_tablet" />

                        <TextView
                            android:id="@+id/panelSpecsBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="Galaxy Tab S10 Ultra · 2960 × 1848 · 120 Hz"
                            android:textColor="@color/aurora_ink_tertiary"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Center Content Column (Constrained to max width 460dp for compact/portrait) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:maxWidth="460dp">

                    <!-- 2. Hero Section -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:id="@+id/radarIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/ring_hero">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_device_desktop" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/dashStatusTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Connect to Mac"
                            android:textColor="@color/aurora_ink"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/dashStatusSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pick how to connect your device"
                            android:textColor="@color/aurora_ink_secondary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <!-- 3. Connection Cards (Stacked Vertically for Compact / Mobile / Narrow Screens) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Card 1: USB-C Cable (Recommended) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/card_aurora_bg"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_recommended"
                                android:paddingStart="9dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="9dp"
                                android:paddingBottom="2dp"
                                android:text="Recommended"
                                android:textColor="@color/aurora_blue_dark"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-medium" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_usb" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="USB-C cable"
                                    android:textColor="@color/aurora_ink"
                                    android:textSize="15sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="7dp"
                                    android:paddingBottom="2dp"
                                    android:text="5 Gbps"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="7dp"
                                    android:paddingBottom="2dp"
                                    android:text="&lt; 1 ms"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="7dp"
                                    android:paddingBottom="2dp"
                                    android:text="85 Mbps"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="7dp"
                                    android:paddingBottom="2dp"
                                    android:text="120 FPS"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutUsbStatus"
                                android:layout_width="match_parent"
                                android:layout_height="34dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/status_pill_bg"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ProgressBar
                                    android:id="@+id/searchProgress"
                                    style="?android:attr/progressBarStyleSmall"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:indeterminate="true"
                                    android:indeterminateTint="@color/aurora_blue" />

                                <ImageView
                                    android:id="@+id/ivUsbStatusIcon"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_check_circle"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tvStatusMessage"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="Looking for your Mac over USB-C..."
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="11sp"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                            </LinearLayout>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnConnectUsb"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/btn_aurora_outlined"
                                android:text="Stop searching"
                                android:textColor="@color/aurora_blue"
                                android:textSize="13sp"
                                android:textAllCaps="false"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <!-- Card 2: Wi-Fi (Wireless) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/card_aurora_bg"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_wireless"
                                android:paddingStart="9dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="9dp"
                                android:paddingBottom="2dp"
                                android:text="Wireless"
                                android:textColor="@color/aurora_sky_dark"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-medium" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_wifi" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Wi-Fi"
                                    android:textColor="@color/aurora_ink"
                                    android:textSize="15sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="7dp"
                                    android:paddingBottom="2dp"
                                    android:text="Wi-Fi 6E / 7"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="7dp"
                                    android:paddingBottom="2dp"
                                    android:text="Adaptive bitrate"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/chip_spec"
                                    android:paddingStart="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="7dp"
                                    android:paddingBottom="2dp"
                                    android:text="120 FPS"
                                    android:textColor="@color/aurora_ink_tertiary"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutWifiDiscovery"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="8dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:id="@+id/layoutFoundMac"
                                    android:layout_width="match_parent"
                                    android:layout_height="34dp"
                                    android:background="@drawable/status_pill_bg"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:src="@drawable/ic_device_desktop" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvDiscoveredMacTitle"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Mac mini M4"
                                            android:textColor="@color/aurora_ink"
                                            android:textSize="11sp"
                                            android:fontFamily="sans-serif-medium" />

                                        <TextView
                                            android:id="@+id/tvWifiDiscoveryStatus"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Searching via Bonjour..."
                                            android:textColor="@color/aurora_ink_secondary"
                                            android:textSize="10sp" />
                                    </LinearLayout>

                                    <ImageView
                                        android:id="@+id/ivWifiFoundCheck"
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:src="@drawable/ic_check_circle"
                                        android:visibility="gone" />
                                </LinearLayout>

                                <EditText
                                    android:id="@+id/manualIpInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="5dp"
                                    android:background="@drawable/edittext_aurora"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp"
                                    android:hint="Mac IP, e.g. 192.168.1.17"
                                    android:textColor="@color/aurora_ink"
                                    android:textColorHint="@color/aurora_ink_secondary"
                                    android:textSize="12sp"
                                    android:inputType="textUri"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/btnToggleManualIp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Enter IP manually"
                                    android:textColor="@color/aurora_blue"
                                    android:textSize="11sp"
                                    android:padding="2dp" />
                            </LinearLayout>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnConnectWifi"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/btn_aurora_tonal"
                                android:text="Connect over Wi-Fi"
                                android:textColor="@color/aurora_blue_dark"
                                android:textSize="13sp"
                                android:textAllCaps="false"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 4. Bottom Feature Strip (2x2 Grid for Responsive Compact Screens) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/card_aurora_bg"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- Row 1: S Pen ready + Native 120 Hz -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="4dp">

                                <FrameLayout
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/feature_circle_bg">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_pencil" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="S Pen ready"
                                        android:textColor="@color/aurora_ink"
                                        android:textSize="11sp"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Pressure, tilt and hover"
                                        android:textColor="@color/aurora_ink_secondary"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="4dp">

                                <FrameLayout
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/feature_circle_bg">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_gauge" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Native 120 Hz"
                                        android:textColor="@color/aurora_ink"
                                        android:textSize="11sp"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Full resolution, no bars"
                                        android:textColor="@color/aurora_ink_secondary"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Row 2: HEVC decoding + Main or extra -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="4dp">

                                <FrameLayout
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/feature_circle_bg">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_bolt" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="HEVC decoding"
                                        android:textColor="@color/aurora_ink"
                                        android:textSize="11sp"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Hardware, low latency"
                                        android:textColor="@color/aurora_ink_secondary"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="4dp">

                                <FrameLayout
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/feature_circle_bg">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_devices" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Main or extra"
                                        android:textColor="@color/aurora_ink"
                                        android:textSize="11sp"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Use as Mac's display"
                                        android:textColor="@color/aurora_ink_secondary"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Floating HUD Overlay (Visible only when streaming 120 FPS Mac desktop) -->
    <LinearLayout
        android:id="@+id/hudOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/hud_background"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected (USB 5 Gbps)"
            android:textColor="@color/aurora_success"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/fpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="120 FPS"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:id="@+id/speedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="⚡ 85.0 Mbps"
            android:textColor="@color/aurora_sky"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <androidx.appcompat.widget.AppCompatButton
