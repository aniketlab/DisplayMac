<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A0F">

    <!-- 120Hz Hardware Accelerated Video Surface -->
    <SurfaceView
        android:id="@+id/videoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Professional Dashboard UI (Visible when not streaming) -->
    <LinearLayout
        android:id="@+id/dashboardLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#070A0F"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="DisplayMac"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_pill"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="PRO 120Hz"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/panelSpecsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/badge_pill"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="14.6&quot; Dynamic AMOLED 2X • 2960×1848"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </RelativeLayout>

        <!-- Center Connection Control Area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/radarIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_mac_mini" />

                <TextView
                    android:id="@+id/dashStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Connect to Mac mini M4"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/dashStatusSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choose how you want to connect your Galaxy Tab S10 Ultra:"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <!-- TWO EXPLICIT CONNECTION MODE CARDS -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="20dp">

                    <!-- CARD 1: USB-C DATA CABLE (Recommended) -->
                    <LinearLayout
                        android:layout_width="340dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_highlight_usb"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:layout_marginEnd="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ RECOMMENDED • 0ms LAG"
                            android:textColor="#10B981"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="USB-C Data Cable"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="• Direct 5 Gbps physical wire\n• 0.5ms sub-millisecond wire latency\n• Full 85 Mbps 120 FPS Retina quality\n• Target: 127.0.0.1 (ADB tunnel)"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnConnectUsb"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/btn_usb_gradient"
                            android:text="⚡ Connect via USB Cable"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>

                    <!-- CARD 2: WI-FI WIRELESS LINK -->
                    <LinearLayout
                        android:layout_width="340dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_highlight_wifi"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📶 WIRELESS LINK"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Local Wi-Fi Network"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-bold" />

                        <TextView
                            android:id="@+id/tvWifiDiscoveryStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="• Both devices on same Wi-Fi router\n• Auto-discovering Mac via Bonjour...\n• Smooth 40 Mbps 120 FPS link"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />

                        <EditText
                            android:id="@+id/manualIpInput"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/edittext_bg"
                            android:hint="Mac IP (e.g. 192.168.1.17)"
                            android:textColorHint="#475569"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:inputType="textUri"
                            android:singleLine="true" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnConnectWifi"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/btn_primary"
                            android:text="📶 Connect via Wi-Fi"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Feedback & Progress Area -->
                <ProgressBar
                    android:id="@+id/searchProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="#38BDF8"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvStatusMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="For USB: Run './setup_usb.sh' on Mac | For Wi-Fi: Run 'swift run' on Mac"
            android:textColor="#475569"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Floating HUD during Live Stream (Pill Overlay with Disconnect Button) -->
    <LinearLayout
        android:id="@+id/hudOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/hud_background"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <View
            android:id="@+id/statusIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/circle_green" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Connected (USB 5 Gbps)"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/fpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="120 Hz"
            android:textColor="@color/status_green"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:id="@+id/speedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="⚡ 0.0 Mbps"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold" />

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:background="#33FFFFFF" />

        <!-- Disconnect Button Inside HUD -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDisconnect"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/btn_disconnect_bg"
            android:text="✕ Disconnect"
            android:textAllCaps="false"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

</FrameLayout>
