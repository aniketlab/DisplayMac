# Default behavior for text files
* text=auto

# Force LF on shell scripts, macOS command files, source code, and Android resources
*.sh text eol=lf
*.command text eol=lf
gradlew text eol=lf
*.swift text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.c text eol=lf
*.h text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.pro text eol=lf

# Force CRLF on Windows scripts
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Binary files
*.png binary
*.jar binary
*.webp binary
*.apk binary
